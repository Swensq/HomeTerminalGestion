<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".UsuarioFormActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTitulo"
                style="@style/Titulo"
                android:text="@string/titulo_usuario_nuevo" />

            <EditText
                android:id="@+id/etNombre"
                style="@style/Campo"
                android:layout_marginTop="24dp"
                android:hint="@string/hint_nombre"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/etUsuario"
                style="@style/Campo"
                android:hint="@string/hint_usuario_nuevo"
                android:inputType="text" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/Campo"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/Campo"
                android:hint="@string/hint_password_nueva"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/etRepetir"
                style="@style/Campo"
                android:hint="@string/hint_repetir_password"
                android:inputType="textPassword" />

            <!-- solo lo ve el administrador -->
            <LinearLayout
                android:id="@+id/layoutRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_rol"
                    android:textColor="@color/calido"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/rgRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/acento"
                        android:text="@string/rol_admin"
                        android:textColor="@color/texto" />

                    <RadioButton
                        android:id="@+id/rbUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/acento"
                        android:checked="true"
                        android:text="@string/rol_usuario"
                        android:textColor="@color/texto" />
                </RadioGroup>
            </LinearLayout>

            <Button
                android:id="@+id/btnGuardar"
                style="@style/Boton"
                android:layout_marginTop="24dp"
                android:text="@string/btn_guardar" />

            <Button
                android:id="@+id/btnEliminar"
                style="@style/BotonPeligro"
                android:text="@string/btn_eliminar"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnVolver"
                style="@style/BotonBorde"
                android:text="@string/btn_volver" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
